{
  "name": "restaurant-solid-blockchain-prototype",
  "version": "1.0.0",
  "description": "Legacy MSc thesis prototype for a restaurant workflow using Solid Pods and Ethereum payment verification.",
  "main": "restaurant.js",
  "engines": {
    "node": ">=18",
    "npm": ">=9"
  },
"scripts": {
  "start": "node restaurant.js",
  "dev": "nodemon restaurant.js",
  "init:pods": "node restaurant.js --initialize",
  "solid:plan": "node restaurant.js --solid-plan",
  "solid:probe": "node restaurant.js --solid-probe",
  "solid:probe:auth": "node restaurant.js --solid-probe-auth",
  "solid:fixtures": "node scripts/solid-fixtures.js",
  "solid:export-plan": "node scripts/solid-export-plan.js",
  "solid:env": "node scripts/solid-env-check.js",
  "solid:readiness": "npm run solid:env && npm run solid:fixtures && npm run solid:export-plan",
  "clean:runtime": "rm -rf utils/runtime",
  "doctor": "node scripts/doctor.js",
  "test:local-flow": "node scripts/test-local-flow.js",
  "test": "npm run doctor && npm run test:local-flow"
},
  "keywords": [
    "solid",
    "solid-pods",
    "ethereum",
    "metamask",
    "express",
    "ejs",
    "msc-thesis",
    "prototype"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@inrupt/generate-oidc-token": "^0.1.3",
    "@inrupt/solid-client": "^1.20.2",
    "@inrupt/solid-client-authn-node": "^1.11.7",
    "@inrupt/vocab-common-rdf": "^1.0.3",
    "@metamask/legacy-web3": "^2.0.0",
    "commander": "^8.3.0",
    "dotenv": "^16.4.7",
    "ejs": "^3.1.6",
    "express": "^4.17.3",
    "filereader": "^0.10.3",
    "nodemon": "^2.0.15",
    "path": "^0.12.7",
    "pdfkit": "^0.13.0",
    "qrcode": "^1.5.0",
    "web3": "^1.7.1"
  }
}
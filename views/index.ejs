<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <title>Restaurant Web-App</title>
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no" />
    <script src="https://use.fontawesome.com/releases/v5.15.4/js/all.js" crossorigin="anonymous"></script>
    <link href="https://fonts.googleapis.com/css?family=Varela+Round" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css?family=Nunito:200,300,400,600,700,800,900" rel="stylesheet" />
    <link rel="stylesheet" href="/css/index-style.css" />
</head>

<body id="page-top">
    <header class="masthead">
        <div class="container px-4 px-lg-5 d-flex h-100 align-items-center justify-content-center">
            <div class="d-flex justify-content-center">
                <div class="text-center">
                    <h1 class="mx-auto my-0 text-uppercase">Restaurant</h1>
                    <h2 class="text-white-50 mx-auto mt-2 mb-4">
                        Solid Pods and blockchain-based payment prototype.
                    </h2>

                    <p class="text-white-50 mx-auto mb-4">
                        Select a table to start the demo.
                    </p>

                    <div class="d-flex flex-wrap justify-content-center gap-3">
                        <% for (let i = 1; i <= tableCount; i++) { %>
                            <a class="btn btn-primary m-2" href="/<%= i %>">
                                Table <%= i %>
                            </a>
                        <% } %>
                    </div>

                    <p class="text-white-50 mx-auto mt-5 small">
                        Base URL: <%= baseUrl %>
                    </p>
                </div>
            </div>
        </div>
    </header>

    <div id="footer">
        <section class="bg-black">
            <div class="container px-4 px-lg-5">
                <div class="social d-flex justify-content-center">
                    <a class="m-3 mx-2" href="#!"><i class="fab fa-twitter"></i></a>
                    <a class="m-3 mx-2" href="#!"><i class="fab fa-facebook-f"></i></a>
                    <a class="m-3 mx-2" href="#!"><i class="fab fa-instagram"></i></a>
                </div>
            </div>
        </section>
        <footer class="footer bg-black small text-center text-white-50 d-flex flex-wrap justify-content-between align-items-center py-3">
            <div class="container px-4 px-lg-5">
                <p class="col-md-4 text-muted">© 2021 ShakerMaker Group, Inc</p>
            </div>
        </footer>
    </div>
</body>

</html>
# Solid demo configuration example
# Copy selected values into your local .env.
# Do not commit real credentials.

# Recommended dedicated test context
SOLID_ROOT_CONTEXT=restaurant-demo
SOLID_TEST_NUMBER=1

# Pod base URL.
# Must end with /
# Example:
# ADMIN_POD_BASE_URL=https://your-pod-provider.example/your-username/
ADMIN_POD_BASE_URL=

# Solid authentication
SOLID_AUTH_ENABLED=false
ALLOW_POD_RESET=false

# Admin Solid credentials
ADMIN_SOLID_PROVIDER=
ADMIN_SOLID_REFRESH_TOKEN=
ADMIN_SOLID_CLIENT_ID=
ADMIN_SOLID_CLIENT_SECRET=

# Restaurant Solid credentials
RESTAURANT_SOLID_PROVIDER=
RESTAURANT_SOLID_REFRESH_TOKEN=
RESTAURANT_SOLID_CLIENT_ID=
RESTAURANT_SOLID_CLIENT_SECRET=

# WebIDs
RESTAURANT_INRUPT_WEB_ID=
RESTAURANT_WEB_ID=
CEO_WEB_ID=
AUTHORITY_WEB_ID=
ERP_WEB_ID=
ADMIN_WEB_ID=

# Keep payment mock while rebuilding Solid
PAYMENT_MODE=mock
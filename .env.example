PORT=8080
BASE_URL=http://localhost:8080
TABLE_COUNT=4

SOLID_ROOT_CONTEXT=testing/root1
SOLID_TEST_NUMBER=1
# Safety flag for Solid Pod initialization.
# Keep false by default. Set true only when you intentionally want to reset/recreate the configured Solid test container.
ALLOW_POD_RESET=false

ADMIN_POD_BASE_URL=https://pod.inrupt.com/admintest1/

ADMIN_SOLID_PROVIDER=https://broker.pod.inrupt.com
ADMIN_SOLID_REFRESH_TOKEN=
ADMIN_SOLID_CLIENT_ID=
ADMIN_SOLID_CLIENT_SECRET=

RESTAURANT_SOLID_PROVIDER=https://solidcommunity.net
RESTAURANT_SOLID_REFRESH_TOKEN=
RESTAURANT_SOLID_CLIENT_ID=
RESTAURANT_SOLID_CLIENT_SECRET=

RESTAURANT_INRUPT_WEB_ID=https://pod.inrupt.com/ristorante1/profile/card#me
RESTAURANT_WEB_ID=https://ristorante1.solidcommunity.net/profile/card#me
CEO_WEB_ID=https://restaurantCEO.solidcommunity.net/profile/card#me
AUTHORITY_WEB_ID=https://pod.inrupt.com/authoritycheck/profile/card#me
ERP_WEB_ID=https://pod.inrupt.com/erp/profile/card#me
ADMIN_WEB_ID=https://pod.inrupt.com/admintest1/profile/card#me

ETH_NETWORK=sepolia
ETH_RPC_URL=
SMART_CONTRACT_ADDRESS=
RESTAURANT_WALLET_ADDRESS=
ETH_CHF_RATE=3919

# Local demo mode
USE_LOCAL_DATA_FALLBACK=true
SOLID_AUTH_ENABLED=false

# Payment mode
# mock = complete the demo without MetaMask/blockchain
# blockchain = use real wallet/blockchain flow, not yet modernized
PAYMENT_MODE=mock